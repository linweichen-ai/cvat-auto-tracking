{
  "manifest_version": 3,
  "name": "CVAT 自助标注面板（SAM3 自动跟踪）",
  "version": "1.0.0",
  "description": "在 CVAT 标注作业页注入 SAM3 自动跟踪悬浮面板：缓存帧→逐实例范围跟踪→跳转检查。",
  "permissions": ["cookies"],
  "host_permissions": [
    "http://172.16.88.68:12080/*",
    "http://172.16.88.68:11089/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://172.16.88.68:12080/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
